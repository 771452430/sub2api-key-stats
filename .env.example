# Read-only PostgreSQL connection to Sub2API. Do not use the Sub2API owner credentials here.
SUB2API_DATABASE_URL=postgresql://key_stats_reader:change-me@sub2api-postgres:5432/sub2api
DATABASE_SSL=false

# PostgreSQL owned by this key-stats app. Lookup-token mappings are stored here.
APP_DATABASE_URL=postgresql://key_stats_app:change-me@key-stats-postgres:5432/key_stats
APP_DATABASE_SSL=false

# Generate both with a password manager or `openssl rand -base64 48`.
LOOKUP_TOKEN_PEPPER=replace-with-a-long-random-hmac-secret
LOOKUP_ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Basic in-memory lookup throttling per client IP.
USAGE_LOOKUP_RATE_LIMIT=30
USAGE_LOOKUP_WINDOW_SECONDS=60
